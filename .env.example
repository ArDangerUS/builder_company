# ===========================================
# Builder Company - Environment Configuration
# ===========================================
# Copy this file to .env and update values

# ==================
# Django Settings
# ==================
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,builder.example.com
DJANGO_SETTINGS_MODULE=config.settings.prod

# ==================
# Database (PostgreSQL)
# ==================
POSTGRES_DB=builder_company
POSTGRES_USER=builder
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgres://builder:change-this-password@db:5432/builder_company

# For local development with SQLite
# DATABASE_URL=sqlite:///db.sqlite3

# ==================
# Redis / Celery
# ==================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ==================
# Email Configuration
# ==================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@builder.example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=Builder Company <noreply@builder.example.com>

# For development (console backend - prints emails to console)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ==================
# CORS
# ==================
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://builder.example.com

# ==================
# JWT Settings
# ==================
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=7

# ==================
# Frontend
# ==================
VITE_API_URL=http://localhost:8000/api/v1

# For production
# VITE_API_URL=https://api.builder.example.com/api/v1

# ==================
# Sentry (optional error tracking)
# ==================
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ==================
# Logging
# ==================
LOG_LEVEL=INFO
